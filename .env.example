# Copy to .env (gitignored). Never commit a real key.
#
# Project (US): e5d97cf1-860e-4b1e-86da-ac908a8c3a3f
# The key is NOT the literal text "<your-project-api-key>" from hackathon docs.
# Create it in the browser (no TypeScript in this repo required):
#   https://app.neatlogs.com → select that project → Settings → API Keys → copy ingest key
NEATLOGS_API_KEY=

# US ingest (default). EU: https://eu.ingest.neatlogs.com
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com

# Per entry point: capacity-investigation (loadline run), tracing-self-test (probe)
# NEATLOGS_WORKFLOW_NAME=capacity-investigation

# Pydantic AI model for hosted probe and future loadline run
# LOADLINE_MODEL=openai:gpt-4o-mini

# Provider keys (set one matching LOADLINE_MODEL)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
